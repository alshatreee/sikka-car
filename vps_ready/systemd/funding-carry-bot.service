[Unit]
Description=Funding Rate Carry Bot - Delta-Neutral Bybit
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/bots
ExecStart=/usr/bin/python3 /root/bots/funding_carry_bot.py
Restart=always
RestartSec=30
StandardOutput=append:/root/bots/funding_carry.log
StandardError=append:/root/bots/funding_carry.log

[Install]
WantedBy=multi-user.target
